# ============================================================================
# .htaccess — Redirección de myspectra.com.mx/ticketInterno al sistema ULTRA
# Colocar en la raíz pública (public_html) del dominio en cPanel.
#
# El Sistema de Tickets ULTRA corre en el servidor Windows y se expone por
# Cloudflare Tunnel en el subdominio de marca: ticketinterno.myspectra.com.mx
# Esta redirección lleva /ticketInterno a ese subdominio.
# La barra del navegador mostrará https://ticketinterno.myspectra.com.mx
# (tu propio dominio, con HTTPS) — no expone Cloudflare, IP ni puerto.
# ============================================================================

RewriteEngine On

# Redirección 302 de /ticketInterno (mayus/minus indistinto, con o sin barra)
# hacia el subdominio de marca servido por el túnel Cloudflare.
RewriteRule ^ticketInterno/?$ https://ticketinterno.myspectra.com.mx/ [R=302,L,NC]
