# ===== ULTRA Tickets Internos - Variables de entorno =====
# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor Fastify (splash + app + API + Socket.IO)
PORT=3080
HOST=0.0.0.0

# Secreto para firmar JWT. GENERA UNO PROPIO: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_LARGO

# Minutos de inactividad antes del cierre automatico de sesion/login
SESSION_IDLE_MINUTES=20

# Dominio corporativo permitido para login
CORP_DOMAIN=corporativoultra.com

# PIN para alta/baja de usuarios en Configuracion
ADMIN_PIN=1033

# Correo de soporte mostrado en el pie
SUPPORT_EMAIL=soporte.spectra@corporativoultra.com

# Contacto VAPID (mailto) para Web Push
VAPID_SUBJECT=mailto:soporte.spectra@corporativoultra.com

# Numero maximo de respaldos a retener
BACKUP_RETENTION=30

# Entorno
NODE_ENV=production
