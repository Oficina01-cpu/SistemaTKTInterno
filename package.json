{
  "name": "ultra-tickets-internos",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Tickets Interno corporativo ULTRA - Fastify + node:sqlite + Socket.IO + Web Push",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/db.js --seed",
    "genvapid": "node scripts/gen-vapid.js",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/app.css --watch"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "daisyui": "^4.12.23",
    "tailwindcss": "^4.0.0"
  }
}
